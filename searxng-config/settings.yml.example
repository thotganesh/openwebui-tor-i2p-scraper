use_default_settings: true

general:
  debug: false
  instance_name: "SearXNG for OpenWebUI"
  enable_metrics: false

search:
  safe_search: 0
  autocomplete: ""
  default_lang: "it-IT"
  formats:
    - html
    - json

server:
  secret_key: "CHANGE_ME_generate_with_openssl_rand_hex_32"
  limiter: false
  image_proxy: false
  method: "GET"

ui:
  static_use_hash: true

redis:
  url: false

outgoing:
  request_timeout: 10.0
  max_request_timeout: 15.0
  pool_connections: 100
  pool_maxsize: 20
  enable_http2: true

engines:
  - name: google
    engine: google
    shortcut: go
    disabled: false
  - name: bing
    engine: bing
    shortcut: bi
    disabled: false
  - name: duckduckgo
    engine: duckduckgo
    shortcut: ddg
    disabled: false
  - name: brave
    engine: brave
    shortcut: br
    disabled: false
  - name: wikipedia
    engine: wikipedia
    shortcut: wp
    disabled: false
  - name: qwant
    engine: qwant
    shortcut: qw
    disabled: false
