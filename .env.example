# ============================================================
# OpenWebUI Tor/I2P Scraper - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env - it contains secrets.

# ============================================================
# Tor ControlPort credentials
# ============================================================
# Plain-text password used by browser-tor to request new circuits (NEWNYM).
# Must match the hashed password below.
TOR_CONTROL_PASSWORD=change-me

# Hashed password used by tor-proxy (torrc).
# Generate with:
#   docker run --rm debian:bookworm-slim bash -c \
#     "apt-get update -qq && apt-get install -y -qq tor >/dev/null && tor --hash-password 'YourSecurePassword'"
TOR_CONTROL_HASH=16:PASTE_THE_GENERATED_HASH_HERE

# ============================================================
# Notes
# ============================================================
# - SearXNG secret key is set in searxng-config/settings.yml (not here)
# - Google Custom Search API is NOT used (SearXNG replaces it)
# - Proxy support is not yet implemented (future enhancement)
